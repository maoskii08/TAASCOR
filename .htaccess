<IfModule mod_rewrite.c>
    RewriteEngine On

    # PHP implementation directories are internal-only. Server-side
    # require/include calls are unaffected by this URL-level rule.
    RewriteRule (^|/)(config|includes|model)(/|$) - [F,L,NC]
</IfModule>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
    Header always unset X-Powered-By
</IfModule>
