# Optional environment-based database configuration. Leave secrets blank here.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=

# Required before registering or releasing smart-run payslips.
# Use an absolute directory outside the web/document root.
TAASCOR_PAYSLIP_ARTIFACT_ROOT=

# Canonical application URL used in password-reset links.
# Production must use HTTPS. Localhost/127.0.0.1 may use HTTP.
TAASCOR_APP_URL=

# Random secret, at least 32 characters, used only for security fingerprints.
TAASCOR_SECURITY_KEY=

# Optional; defaults to noreply@taascor.visiotechsolutions.com.
TAASCOR_MAIL_FROM=

# Set to 1 in production to force Secure session cookies.
TAASCOR_SESSION_SECURE=

# TASCA Gemini AI. Prefer TAASCOR_GEMINI_ENV_FILE pointing to a private file
# outside the web root. Never commit a real API key.
TAASCOR_GEMINI_ENV_FILE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_CA_BUNDLE=

# Recruitment and onboarding. The source release stage is also fail-closed, so
# these values cannot activate production workflows in the foundation release.
TAASCOR_RECRUITMENT_PUBLIC_JOBS_ENABLED=0
TAASCOR_RECRUITMENT_STAFF_ENABLED=0
TAASCOR_RECRUITMENT_CANDIDATE_ENABLED=0
TAASCOR_RECRUITMENT_MUTATIONS_ENABLED=0
TAASCOR_RECRUITMENT_EMPLOYEE_CONVERSION_ENABLED=0

# Private keys must be at least 32 random characters and must never be committed.
# The lookup key creates deterministic email lookup hashes. The data key will
# protect candidate contact and application content when identity work begins.
TAASCOR_RECRUITMENT_LOOKUP_KEY=
TAASCOR_RECRUITMENT_DATA_KEY=

# Provider and private document storage remain blank until approved. The
# document root must be an absolute path outside the public web directory.
TAASCOR_RECRUITMENT_MAIL_PROVIDER=
TAASCOR_RECRUITMENT_MAIL_FROM=
TAASCOR_RECRUITMENT_PUBLIC_BASE_URL=
TAASCOR_RECRUITMENT_DOCUMENT_ROOT=
TAASCOR_RECRUITMENT_SCANNER_COMMAND=
TAASCOR_RECRUITMENT_PRIVACY_NOTICE_VERSION=
